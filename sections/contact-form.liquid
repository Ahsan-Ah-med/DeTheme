{{ 'section.css' | asset_url | stylesheet_tag }}
{{ 'button-style.css' | asset_url | stylesheet_tag }}
<link href="{{ 'custom-effect.css' | asset_url }}" rel="stylesheet" media="print" onload="this.media='all'">
{%-liquid
    assign sid = section.id
    assign se_stts = section.settings  
    assign se_blocks = section.blocks  
    assign stt_layout = se_stts.layout
    assign stt_image_bg = se_stts.image_bg
    if stt_layout == 'sr4-se-container' 
        assign html_layout = '<div class="sr4-container">__</div></div>' | split:'__'
    elsif stt_layout == 'sr4-container-wrap'
        assign html_layout = '<div class="sr4-container">__</div>' | split:'__'
    else
        assign html_layout = '__' | split:'__'
    endif 
    assign page_content = page.content   
    assign formId = 'contact_form_page'
    assign sr4_se_class = 'sr4_nt_se_' |append:sid
    if se_stts.use_cus_css and se_stts.code_cus_css != blank
        render 'se_cus_css',code_cus_css:se_stts.code_cus_css,sr4_se_class:sr4_se_class
    endif 
-%}
{%- if se_stts.enable_map %}<style>.sr4-se_contact_map iframe {margin-bottom: 0;padding: 0;display: block;width: 100%;border: none;}</style><div class="sr4-se_contact_map">{{se_stts.map}}</div>{% endif -%}
<div class="sr4-section-inner {{sr4_se_class}} sr4_nt_se_{{sid}} {{stt_layout}}{% if stt_image_bg != blank and stt_layout != 'sr4-se-container' %} sr4-has-imgbg lazyloadsr4{% endif %}" {% if stt_image_bg != blank and stt_layout != 'sr4-se-container' %} data-bgset="{{ stt_image_bg | image_url: width: 1 }}" data-sizes="auto"  data-optimumx="2"{% endif %} {% render 'section_style',se_stts:se_stts -%} >
    {{-html_layout[0]-}}
    {%- if stt_layout == 'sr4-se-container' -%}
        <div class="sr4-container-inner{% if stt_image_bg != blank %} sr4-has-imgbg lazyloadsr4{% endif %}" {% if stt_image_bg != blank %} data-bgset="{{ stt_image_bg | image_url: width: 1 }}" data-sizes="auto"  data-optimumx="2"{% endif %}>{% endif -%}
        <div class="sr4-row sr4-justify-content-center main_row">
            {%- for block in section.blocks -%}
                {%- assign bk_stts = block.settings -%} 
                {%- assign button_style = bk_stts.button_style-%}
                {%- case block.type -%}
 
                    {%- when 'bl_form' -%}
                        <div class="sr4-col-item sr4-col-md-6 sr4-col-12 form-div" style="
                            --btn-width-desktop: {{ bk_stts.btn_width_desktop | default: '425' }}px;
                            --btn-width-mobile: {{ bk_stts.btn_width_mobile | default: '312' }}px;
                            --btn-heightt: {{ bk_stts.btn_height | default: '39' }}px;
                            --btn-font-size: {{ bk_stts.btn_font_size | default: '14' }}px;
                            --btn-font-weight: {{ bk_stts.btn_font_weight | default: '400' }};
                            --btn-border-radius: {{ bk_stts.btn_border_radius | default: '0' }}px;
                            --btn-letter-spacing: {{ bk_stts.btn_letter_spacing | default: '0.7' }}px;
                            --btn-bg-color: {{ bk_stts.btn_bg_color | default: '#2D2D2D' }};
                        ">
                            {%- form 'contact', id: formId -%}
                 
               {%- render 'form-status', form: form, form_id: formId -%}
                               {% if bk_stts.heading != blank %} <h3 class="sr4-form-title">{{bk_stts.heading}}</h3>{% endif %}
                                <input type="hidden" name="contact[form]" value="New Bridal Inquiry - International Site">
                          <div class="contact_form-field">
                                <p class="name-contact">
                                    <input placeholder="Full Name" required="required" type="text" id="{{ formId }}-name" name="contact[name]" value="{% if form[name] %}{{ form[name] }}{% elsif customer %}{{ customer.name }}{% endif %}">
                                </p>
 
                                <p class="email-contact">
                                    <input placeholder="Email" required="required" type="email" id="{{ formId }}-email" name="contact[email]" autocorrect="off" autocapitalize="off" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" aria-required="true" required="required"
                                    {%- if form.errors contains 'email' -%}class="sr4-input--error" aria-invalid="true" aria-describedby="{{ formId }}-email-error"{%- endif -%}
                                >
                                    {%- if form.errors contains 'email' -%}
                
                                        <span id="{{ formId}}-email-error" class="sr4-input-error-message"><i class="las la-exclamation-triangle"></i>{{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}.</span>
                                    {%- endif -%}
                                </p>
                          
   </div>
                                {%- if bk_stts.enable_phone -%}
                                    <p>
                                        <input placeholder="Number" required="required" type="tel" id="{{ formId }}-phone" name="contact[phone]" pattern="[0-9\-]*" value="{% if form[phone] %}{{ form[phone] }}{% elsif customer %}{{ customer.phone }}{% endif %}">
                                     </p>
                                {%- endif -%}
                                <p>
                                 
                                    <textarea placeholder="Message" rows="20" id="{{ formId }}-message" name="contact[body]" required="required" class="sr4-input-textarea">{% if form.body %}{{ form.body }}{% endif %}</textarea>
                                </p>
             
                    <div class="submit_div">
                                <input type="submit" class="sr4-btn contact_submit sr4-btn-base sr4-btn-style-{{button_style}} sr4-btn-size-{{bk_stts.btn_size}} sr4-btn-color-{{bk_stts.btn_cl}}{% if bk_stts.enable_full_btn %} sr4-w-100 sr4-justify-content-center{% endif %} sr4-btn-effect-fade sr4-cursor-pointer" value="{{ 'templates.contact.form.submit' | t }}">
                           
  </div>
                            
                            {%- endform -%}
                        </div>
                 
                    {%- else -%}
                        <div class="sr4-col-item sr4-contact-info sr4-col-md-6 sr4-col-12 sr4-rte contact-head" style="--svg-custom-color: {{ bk_stts.svg_color | default: '#393939' }};">
                            {%- if bk_stts.heading != blank -%}<h3 class="sr4-info-heading">{{bk_stts.heading}}</h3>{%- endif -%}
                            
                            {%- comment -%} Phone Dynamic Block {%- endcomment -%}
                            {%- if bk_stts.phone_label != blank and bk_stts.phone_number != blank -%}
                            <div class="contact_item">
                                <div class="heading_con sr4-fnt-fm-{{ bk_stts.font_heading }}">{{ bk_stts.phone_label }}</div>
                                <div class="contact_flex">
                                    {%- if bk_stts.phone_icon != blank -%}
                                        <img class="contact_svg_icon" src="{{ bk_stts.phone_icon | image_url: width: 24 }}" alt="" width="20" height="20">
                                    {%- else -%}
                                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M5.57985 13.9215C3.42926 11.7667 1.77537 9.16816 0.733853 6.30751C0.160853 4.74351 0.685853 3.02551 1.86385 1.84751L2.59285 1.11951C2.78884 0.923128 3.02163 0.767326 3.27791 0.661022C3.53418 0.554718 3.80891 0.5 4.08635 0.5C4.3638 0.5 4.63852 0.554718 4.8948 0.661022C5.15107 0.767326 5.38387 0.923128 5.57985 1.11951L7.28685 2.82651C7.48324 3.0225 7.63904 3.25529 7.74534 3.51157C7.85165 3.76784 7.90636 4.04256 7.90636 4.32001C7.90636 4.59746 7.85165 4.87218 7.74534 5.12846C7.63904 5.38473 7.48324 5.61752 7.28685 5.81351L6.86685 6.23351C6.69874 6.40159 6.56538 6.60114 6.47439 6.82076C6.38341 7.04039 6.33658 7.27579 6.33658 7.51351C6.33658 7.75124 6.38341 7.98663 6.47439 8.20626C6.56538 8.42588 6.69874 8.62543 6.86685 8.79351L10.7069 12.6345C10.8749 12.8026 11.0745 12.936 11.2941 13.027C11.5137 13.118 11.7491 13.1648 11.9869 13.1648C12.2246 13.1648 12.46 13.118 12.6796 13.027C12.8992 12.936 13.0988 12.8026 13.2669 12.6345L13.6879 12.2145C13.8838 12.0181 14.1166 11.8623 14.3729 11.756C14.6292 11.6497 14.9039 11.595 15.1814 11.595C15.4588 11.595 15.7335 11.6497 15.9898 11.756C16.2461 11.8623 16.4789 12.0181 16.6749 12.2145L18.3819 13.9215C18.5782 14.1175 18.734 14.3503 18.8403 14.6066C18.9466 14.8628 19.0014 15.1376 19.0014 15.415C19.0014 15.6925 18.9466 15.9672 18.8403 16.2235C18.734 16.4797 18.5782 16.7125 18.3819 16.9085L17.6539 17.6365C16.4759 18.8155 14.7579 19.3405 13.1939 18.7675C10.3332 17.726 7.73462 16.0721 5.57985 13.9215Z" stroke="currentColor" stroke-linejoin="round"></path></svg>
                                    {%- endif -%}
                                    <div>
                                        <a class="sr4-fnt-fm-{{ bk_stts.font_link }}" href="tel:{{ bk_stts.phone_number | replace: ' ', '' }}">{{ bk_stts.phone_number }}</a>
                                        {%- if bk_stts.phone_time != blank -%}<div class="subb__div sr4-fnt-fm-{{ bk_stts.font_subb }}">{{ bk_stts.phone_time }}</div>{%- endif -%}
                                    </div>
                                </div>
                            </div>
                            {%- endif -%}

                            {%- comment -%} WhatsApp Dynamic Block {%- endcomment -%}
                            {%- if bk_stts.whatsapp_label != blank and bk_stts.whatsapp_number != blank -%}
                            <div class="contact_item">
                                <div class="heading_con sr4-fnt-fm-{{ bk_stts.font_heading }}">{{ bk_stts.whatsapp_label }}</div>
                                <div class="contact_flex">
                                    {%- if bk_stts.whatsapp_icon != blank -%}
                                        <img class="contact_svg_icon" src="{{ bk_stts.whatsapp_icon | image_url: width: 24 }}" alt="" width="20" height="20">
                                    {%- else -%}
                                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M14.1544 13.7143C12.6215 15.2471 9.08977 13.9407 7.32434 12.1753C5.55891 10.4098 4.25246 6.8781 5.78532 5.34525C6.22932 4.90125 6.8407 4.84839 7.21422 4.86601C7.43006 4.8757 7.61682 5.00256 7.74279 5.17875L8.58146 6.35394C8.70254 6.52364 8.75952 6.73079 8.74226 6.93855C8.725 7.1463 8.63463 7.34121 8.4872 7.4886L7.69346 8.28234C7.8397 8.72282 8.31013 9.77996 9.01489 10.4847C9.71965 11.1895 10.7768 11.6599 11.2173 11.8061L12.011 11.0133C12.1583 10.8657 12.3531 10.7752 12.5609 10.7578C12.7687 10.7403 12.9759 10.7972 13.1457 10.9182L14.3209 11.7568C14.4971 11.8828 14.6239 12.0696 14.6336 12.2854C14.6512 12.6589 14.5984 13.2703 14.1544 13.7143Z" stroke="currentColor" stroke-linejoin="round"></path><path d="M9.74999 19C14.8586 19 19 14.8586 19 9.74999C19 4.64135 14.8586 0.5 9.74999 0.5C4.64135 0.5 0.5 4.64135 0.5 9.74999C0.5 11.4344 0.950166 13.0148 1.73774 14.375L0.9625 18.5375L5.125 17.7623C6.53052 18.5755 8.12615 19.0025 9.74999 19Z" stroke="currentColor" stroke-linejoin="round"></path></svg>
                                    {%- endif -%}
                                    <div>
                                        <a class="sr4-fnt-fm-{{ bk_stts.font_link }}" target="_blank" href="https://api.whatsapp.com/send?phone={{ bk_stts.whatsapp_number | replace: ' ', '' | replace: '+', '' }}&text={{ bk_stts.whatsapp_msg | url_encode }}">{{ bk_stts.whatsapp_number }}</a>
                                        {%- if bk_stts.whatsapp_time != blank -%}<div class="subb__div sr4-fnt-fm-{{ bk_stts.font_subb }}">{{ bk_stts.whatsapp_time }}</div>{%- endif -%}
                                    </div>
                                </div>
                            </div>
                            {%- endif -%}

                            {%- comment -%} Email Dynamic Block {%- endcomment -%}
                            {%- if bk_stts.email_label != blank and bk_stts.email_address != blank -%}
                            <div class="contact_item">
                                <div class="heading_con sr4-fnt-fm-{{ bk_stts.font_heading }}">{{ bk_stts.email_label }}</div>
                                <div class="contact_flex">
                                    {%- if bk_stts.email_icon != blank -%}
                                        <img class="contact_svg_icon" src="{{ bk_stts.email_icon | image_url: width: 24 }}" alt="" width="20" height="18">
                                    {%- else -%}
                                        <svg width="20" height="18" viewBox="0 0 20 18" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M15 0.5H4.5C2.29086 0.5 0.5 2.29086 0.5 4.5V13.5C0.5 15.7091 2.29086 17.5 4.5 17.5H15C17.2091 17.5 19 15.7091 19 13.5V4.5C19 2.29086 17.2091 0.5 15 0.5Z" stroke="currentColor"></path><path d="M0.546875 4.59003L7.75187 8.72003C8.35565 9.07038 9.04131 9.25491 9.73938 9.25491C10.4374 9.25491 11.1231 9.07038 11.7269 8.72003L18.9519 4.59003" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                                    {%- endif -%}
                                    <a class="sr4-fnt-fm-{{ bk_stts.font_link }}" href="mailto:{{ bk_stts.email_address }}">{{ bk_stts.email_address }}</a>
                                </div>
                            </div>
                            {%- endif -%}

                            {%- comment -%} Studio Dynamic Block {%- endcomment -%}
                            {%- if bk_stts.studio_label != blank and bk_stts.studio_address != blank -%}
                            <div class="contact_item">
                                <div class="heading_con sr4-fnt-fm-{{ bk_stts.font_heading }}">{{ bk_stts.studio_label }}</div>
                                <div class="contact_flex last_two_m">
                                    {%- if bk_stts.studio_icon != blank -%}
                                        <img class="contact_svg_icon" src="{{ bk_stts.studio_icon | image_url: width: 24 }}" alt="" width="19" height="24">
                                    {%- else -%}
                                        <svg width="19" height="24" viewBox="0 0 19 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M4.19434 9.77216C4.19434 8.36522 4.75324 7.0159 5.7481 6.02105C6.74296 5.02619 8.09227 4.46729 9.49921 4.46729C10.9062 4.46729 12.2555 5.02619 13.2503 6.02105C14.2452 7.0159 14.8041 8.36522 14.8041 9.77216C14.8041 11.1791 14.2452 12.5284 13.2503 13.5233C12.2555 14.5181 10.9062 15.077 9.49921 15.077C8.09227 15.077 6.74296 14.5181 5.7481 13.5233C4.75324 12.5284 4.19434 11.1791 4.19434 9.77216ZM9.49921 5.31144C8.31616 5.31144 7.18155 5.78141 6.34501 6.61796C5.50846 7.4545 5.03849 8.5891 5.03849 9.77216C5.03849 10.9552 5.50846 12.0898 6.34501 12.9264C7.18155 13.7629 8.31616 14.2329 9.49921 14.2329C10.6823 14.2329 11.8169 13.7629 12.6534 12.9264C13.49 12.0898 13.9599 10.9552 13.9599 9.77216C13.9599 8.5891 13.49 7.4545 12.6534 6.61796C11.8169 5.78141 10.6823 5.31144 9.49921 5.31144Z" fill="currentColor"></path><path d="M9.25879 0.5H9.74121C11.9388 0.500503 14.0563 1.3267 15.6729 2.81543C17.2894 4.30417 18.2867 6.34696 18.4678 8.53711C18.6699 10.9869 17.9129 13.4196 16.3564 15.3223L11.0039 21.8682C10.8217 22.0909 10.5921 22.2703 10.332 22.3936C10.072 22.5168 9.78778 22.5811 9.5 22.5811C9.21222 22.5811 8.92802 22.5168 8.66797 22.3936C8.40794 22.2703 8.17827 22.0909 7.99609 21.8682L2.64355 15.3223C1.08713 13.4196 0.330087 10.9869 0.532227 8.53711C0.713285 6.34696 1.71061 4.30417 3.32715 2.81543C4.8426 1.41978 6.79843 0.606477 8.84766 0.509766L9.25879 0.5Z" stroke="currentColor"></path></svg>
                                    {%- endif -%}
                                    <div class="sr4-fnt-fm-{{ bk_stts.font_link }}" class="address_div">{{ bk_stts.studio_address }}</div>
                                </div>
                                
                                {%- if bk_stts.studio_phone != blank -%}
                                <div class="contact_flex last_two_m">
                                    {%- if bk_stts.phone_icon != blank -%}
                                        <img class="contact_svg_icon" src="{{ bk_stts.phone_icon | image_url: width: 24 }}" alt="" width="20" height="20">
                                    {%- else -%}
                                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M5.57985 13.9215C3.42926 11.7667 1.77537 9.16816 0.733853 6.30751C0.160853 4.74351 0.685853 3.02551 1.86385 1.84751L2.59285 1.11951C2.78884 0.923128 3.02163 0.767326 3.27791 0.661022C3.53418 0.554718 3.80891 0.5 4.08635 0.5C4.3638 0.5 4.63852 0.554718 4.8948 0.661022C5.15107 0.767326 5.38387 0.923128 5.57985 1.11951L7.28685 2.82651C7.48324 3.0225 7.63904 3.25529 7.74534 3.51157C7.85165 3.76784 7.90636 4.04256 7.90636 4.32001C7.90636 4.59746 7.85165 4.87218 7.74534 5.12846C7.63904 5.38473 7.48324 5.61752 7.28685 5.81351L6.86685 6.23351C6.69874 6.40159 6.56538 6.60114 6.47439 6.82076C6.38341 7.04039 6.33658 7.27579 6.33658 7.51351C6.33658 7.75124 6.38341 7.98663 6.47439 8.20626C6.56538 8.42588 6.69874 8.62543 6.86685 8.79351L10.7069 12.6345C10.8749 12.8026 11.0745 12.936 11.2941 13.027C11.5137 13.118 11.7491 13.1648 11.9869 13.1648C12.2246 13.1648 12.46 13.118 12.6796 13.027C12.8992 12.936 13.0988 12.8026 13.2669 12.6345L13.6879 12.2145C13.8838 12.0181 14.1166 11.8623 14.3729 11.756C14.6292 11.6497 14.9039 11.595 15.1814 11.595C15.4588 11.595 15.7335 11.6497 15.9898 11.756C16.2461 11.8623 16.4789 12.0181 16.6749 12.2145L18.3819 13.9215C18.5782 14.1175 18.734 14.3503 18.8403 14.6066C18.9466 14.8628 19.0014 15.1376 19.0014 15.415C19.0014 15.6925 18.9466 15.9672 18.8403 16.2235C18.734 16.4797 18.5782 16.7125 18.3819 16.9085L17.6539 17.6365C16.4759 18.8155 14.7579 19.3405 13.1939 18.7675C10.3332 17.726 7.73462 16.0721 5.57985 13.9215Z" stroke="currentColor" stroke-linejoin="round"></path></svg>
                                    {%- endif -%}
                                    <a href="tel:{{ bk_stts.studio_phone | replace: ' ', '' }}">{{ bk_stts.studio_phone }}</a>
                                </div>
                                {%- endif -%}

                                {%- if bk_stts.studio_time != blank -%}
                                <div class="contact_flex">
                                    {%- if bk_stts.time_icon != blank -%}
                                        <img class="contact_svg_icon" src="{{ bk_stts.time_icon | image_url: width: 24 }}" alt="" width="19" height="19">
                                    {%- else -%}
                                        <svg width="19" height="19" viewBox="0 0 19 19" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9.5 0C12.0196 0 14.4359 1.00089 16.2175 2.78249C17.9991 4.56408 19 6.98044 19 9.5C19 12.0196 17.9991 14.4359 16.2175 16.2175C14.4359 17.9991 12.0196 19 9.5 19C6.98044 19 4.56408 17.9991 2.78249 16.2175C1.00089 14.4359 0 12.0196 0 9.5C0 6.98044 1.00089 4.56408 2.78249 2.78249C4.56408 1.00089 6.98044 0 9.5 0ZM9.5 1C7.24566 1 5.08365 1.89553 3.48959 3.48959C1.89553 5.08365 1 7.24566 1 9.5C1 11.7543 1.89553 13.9163 3.48959 15.5104C5.08365 17.1045 7.24566 18 9.5 18C10.6162 18 11.7215 17.7801 12.7528 17.353C13.7841 16.9258 14.7211 16.2997 15.5104 15.5104C16.2997 14.7211 16.9258 13.7841 17.353 12.7528C17.7801 11.7215 18 10.6162 18 9.5C18 7.24566 17.1045 5.08365 15.5104 3.48959C13.9163 1.89553 11.7543 1 9.5 1ZM9 4H10V9.42L14.7 12.13L14.2 13L9 10V4Z" fill="currentColor"></path></svg>
                                    {%- endif -%}
                                    <div class="subb__div sr4-fnt-fm-{{ bk_stts.font_subb }}">{{ bk_stts.studio_time }}</div>
                                </div>
                                {%- endif -%}
                            </div>
                            {%- endif -%}

                        </div>
                {%- endcase -%}
            {%- endfor -%}
        </div>
    {{-html_layout[1]-}}
</div>
<style>
.contact_flex svg {
    color: var(--svg-custom-color);
}
.contact_flex svg path {
    stroke: currentColor;
}
.contact_flex svg path[fill] {
    fill: currentColor;
    stroke: none;
}
.contact_svg_icon {
    object-fit: contain;
    margin-top: 4px;
}
.sr4-contact-form input.sr4-input--error {
    border-color: var(--sr4-error-color)!important;
 margin-bottom: 5px;
}
.sr4-contact-form input[type=date],
.sr4-contact-form input[type=email],
.sr4-contact-form input[type=number], 
.sr4-contact-form input[type=password],
.sr4-contact-form input[type=tel],
.sr4-contact-form input[type=text],
.sr4-contact-form input[type=url],
.sr4-contact-form select,
.sr4-contact-form textarea {
    width: 100%;
 height: 40px;
    line-height: 18px;
    transition: border-color .5s;
    box-shadow: none;
    border-radius: 0;
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    border-radius:10px;
    font-size: 16px;
 background-color: transparent;
}
.sr4-contact-form .sr4-input-textarea{
    padding: 10px 15px !important;
    min-height: 140px;
    overflow:hidden;
 }

.sr4-contact-form .sr4-fine-print{font-style:italic}
